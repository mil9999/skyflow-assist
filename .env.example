# Copy to .env and fill in. .env is gitignored; this file is not.

# Local SQLite database. Resolved relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Shared secret for /api/tools/*. Every request must send it as X-API-Key.
# If this is unset the routes reject everything, by design.
# Generate one with:  openssl rand -hex 32
TOOLS_API_KEY=""

# --- Phase 4: text simulator -------------------------------------------------

# Server-side only. Never returned to the browser.
OPENAI_API_KEY=""

# gpt-5.6-luna is the efficient tier. Switch to gpt-5.6-terra if tool selection
# proves unreliable during evaluation.
TEXT_AGENT_MODEL="gpt-5.6-luna"
TEXT_AGENT_REASONING_EFFORT="low"

# Set to "fake" to click through the simulator with canned replies and spend nothing.
TEXT_AGENT_PROVIDER="openai"

# Guards the demo-reset endpoint. Also requires NODE_ENV=development.
ALLOW_DEMO_RESET="false"

# --- Phase 5: voice ----------------------------------------------------------
