# Copy to .env and fill in. .env is gitignored; this file is not.

# Local SQLite database. Resolved relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Shared secret for /api/tools/*. Every request must send it as X-API-Key.
# If this is unset the routes reject everything, by design.
# Generate one with:  openssl rand -hex 32
TOOLS_API_KEY=""

# Added in Phase 5, not needed yet.
# ELEVENLABS_API_KEY=""
# ELEVENLABS_AGENT_ID=""
