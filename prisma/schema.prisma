// SkyFlow Assist - Phase 1 schema
// SQLite has no native enums, so status fields are strings validated in src/domain/constants.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Passenger {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Flight {
  id             String          @id @default(cuid())
  flightNumber   String          @unique
  origin         String // IATA code, e.g. LHR
  destination    String // IATA code, e.g. CDG
  departureTime  DateTime
  arrivalTime    DateTime
  availableSeats Int             @default(0)
  stops          Int             @default(0)
  connectionVia  String?
  status         String          @default("SCHEDULED") // SCHEDULED | DELAYED | CANCELLED | DEPARTED
  bookings       Booking[]
  disruptions    Disruption[]
  holds          RebookingHold[]
  createdAt      DateTime        @default(now())
}

model Booking {
  id               String                @id @default(cuid())
  bookingReference String                @unique
  passengerId      String
  flightId         String
  seatNumber       String?
  status           String                @default("ACTIVE") // ACTIVE | DISRUPTED | HELD | REBOOKED | CANCELLED
  passenger        Passenger             @relation(fields: [passengerId], references: [id])
  flight           Flight                @relation(fields: [flightId], references: [id])
  holds            RebookingHold[]
  sessions         ConversationSession[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model Disruption {
  id        String   @id @default(cuid())
  flightId  String
  type      String // CANCELLATION | DELAY
  reason    String
  flight    Flight   @relation(fields: [flightId], references: [id])
  createdAt DateTime @default(now())
}

model RebookingHold {
  id          String   @id @default(cuid())
  bookingId   String
  newFlightId String
  status      String   @default("ACTIVE") // ACTIVE | CONFIRMED | EXPIRED | CANCELLED
  expiresAt   DateTime
  booking     Booking  @relation(fields: [bookingId], references: [id])
  newFlight   Flight   @relation(fields: [newFlightId], references: [id])
  createdAt   DateTime @default(now())
}

model ConversationSession {
  id        String       @id @default(cuid())
  bookingId String?
  // UNVERIFIED | VERIFIED | BOOKING_LOADED | OPTIONS_PRESENTED
  // OPTION_HELD | AWAITING_CONFIRMATION | REBOOKED | ESCALATED
  state     String       @default("UNVERIFIED")
  channel   String       @default("TEXT") // TEXT | VOICE

  // Navigation only. The selected flight lives on RebookingHold.newFlightId and
  // "confirmation required" is derived from state === AWAITING_CONFIRMATION.
  activeHoldId String?

  booking            Booking?            @relation(fields: [bookingId], references: [id])
  events             AuditEvent[]
  supportCases       SupportCase[]
  idempotencyRecords IdempotencyRecord[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model SupportCase {
  id                 String              @id @default(cuid())
  sessionId          String
  reason             String // VERIFICATION_FAILED | NO_ALTERNATIVE_FLIGHTS | PASSENGER_REQUEST | POLICY_EXCEPTION | BACKEND_ERROR
  escalatedFromState String
  status             String              @default("OPEN") // OPEN | RESOLVED
  createdAt          DateTime            @default(now())
  resolvedAt         DateTime?
  session            ConversationSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model IdempotencyRecord {
  id           String              @id @default(cuid())
  key          String              @unique
  operation    String
  sessionId    String
  requestHash  String
  responseJson String?
  createdAt    DateTime            @default(now())
  session      ConversationSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model AuditEvent {
  id        String              @id @default(cuid())
  sessionId String
  action    String
  details   String? // JSON string
  session   ConversationSession @relation(fields: [sessionId], references: [id])
  createdAt DateTime            @default(now())

  @@index([sessionId])
}
